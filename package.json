{
  "name": "kotiko-dev",
  "private": true,
  "description": "Development tooling only (tests, lint, e2e). The extension ships no npm code.",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "test": "node --test 'test/{unit,dom,bg}/**/*.test.mjs'",
    "e2e": "playwright test",
    "lint": "eslint . && web-ext lint --source-dir extension --self-hosted",
    "lint:fix": "eslint . --fix",
    "perf": "node test/perf/run.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "axe-core": "4.13.0",
    "chrome-webstore-upload": "6.0.1",
    "chrome-webstore-upload-cli": "4.0.2",
    "cldr-core": "48.2.0",
    "cldr-localenames-full": "48.2.0",
    "eslint": "10.11.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "fake-indexeddb": "6.2.5",
    "fflate": "0.8.3",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stopwords-iso": "1.1.0",
    "web-ext": "10.7.0"
  },
  "overrides": {
    "shell-quote": "1.11.0"
  }
}
