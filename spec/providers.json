{
  "_comment": "Where the extension (and a server, in its own config) can look words up (slice 11 section 4). Every preset is an OpenAI-compatible chat API: POST {baseUrl}/chat/completions with a Bearer key. `jsonMode` says whether to send response_format {type: json_object} (the client drops it once on a 400 that names it); `maxTokensField` names the request field for the output cap (spec/models.json policy.max_tokens, sent on every request): max_tokens unless given; OpenAI's reasoning models take only max_completion_tokens. `modelSource` is how the model list is found: openrouter-free (slice 10's catalog over GET /models and spec/models.json), models-endpoint (GET {baseUrl}/models, ordered by `prefer`), or manual (`prefer`, or a model id the learner types). `notes` is the English source of the line shown under the field; the extension shows its own translated copy. Never put a key here.",
  "default": "openrouter",
  "providers": [
    {
      "id": "openrouter",
      "label": "OpenRouter",
      "baseUrl": "https://openrouter.ai/api/v1",
      "keyRequired": true,
      "keyUrl": "https://openrouter.ai/settings/keys",
      "jsonMode": "json_object",
      "extraHeaders": { "HTTP-Referer": "https://github.com/ScriptKittyOS/kotiko", "X-Title": "Kotiko" },
      "extraBody": {},
      "modelSource": "openrouter-free",
      "prefer": [],
      "free": true,
      "notes": "Free models by default. A key with a credit limit is the safest choice."
    },
    {
      "id": "openai",
      "label": "OpenAI",
      "baseUrl": "https://api.openai.com/v1",
      "keyRequired": true,
      "keyUrl": "https://platform.openai.com/api-keys",
      "jsonMode": "json_object",
      "maxTokensField": "max_completion_tokens",
      "extraHeaders": {},
      "extraBody": {},
      "modelSource": "models-endpoint",
      "prefer": ["gpt-4.1-mini", "gpt-4o-mini"],
      "free": false,
      "notes": "Paid per request; each word costs a fraction of a cent."
    },
    {
      "id": "anthropic",
      "label": "Anthropic",
      "baseUrl": "https://api.anthropic.com/v1",
      "keyRequired": true,
      "keyUrl": "https://console.anthropic.com/settings/keys",
      "jsonMode": "none",
      "extraHeaders": { "anthropic-dangerous-direct-browser-access": "true" },
      "extraBody": {},
      "modelSource": "manual",
      "prefer": ["claude-haiku-4-5"],
      "free": false,
      "beta": true,
      "notes": "Beta: uses Anthropic's OpenAI compatibility layer."
    },
    {
      "id": "gemini",
      "label": "Google Gemini",
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
      "keyRequired": true,
      "keyUrl": "https://aistudio.google.com/apikey",
      "jsonMode": "json_object",
      "extraHeaders": {},
      "extraBody": {},
      "modelSource": "models-endpoint",
      "prefer": ["gemini-2.5-flash", "models/gemini-2.5-flash", "gemini-2.0-flash", "models/gemini-2.0-flash"],
      "free": false,
      "notes": "Google's free tier has its own daily limits."
    },
    {
      "id": "groq",
      "label": "Groq",
      "baseUrl": "https://api.groq.com/openai/v1",
      "keyRequired": true,
      "keyUrl": "https://console.groq.com/keys",
      "jsonMode": "json_object",
      "extraHeaders": {},
      "extraBody": {},
      "modelSource": "models-endpoint",
      "prefer": ["llama-3.3-70b-versatile", "llama-3.1-8b-instant"],
      "free": false,
      "notes": "Fast, with a free tier."
    },
    {
      "id": "ollama",
      "label": "Ollama",
      "baseUrl": "http://localhost:11434/v1",
      "keyRequired": false,
      "keyUrl": null,
      "jsonMode": "json_object",
      "extraHeaders": {},
      "extraBody": {},
      "modelSource": "models-endpoint",
      "prefer": [],
      "free": true,
      "local": true,
      "notes": "Start Ollama with OLLAMA_ORIGINS=chrome-extension://*,moz-extension://*"
    },
    {
      "id": "lmstudio",
      "label": "LM Studio",
      "baseUrl": "http://localhost:1234/v1",
      "keyRequired": false,
      "keyUrl": null,
      "jsonMode": "none",
      "extraHeaders": {},
      "extraBody": {},
      "modelSource": "models-endpoint",
      "prefer": [],
      "free": true,
      "local": true,
      "notes": "Start the server in LM Studio's Developer tab."
    },
    {
      "id": "custom",
      "label": "Custom",
      "baseUrl": null,
      "keyRequired": false,
      "keyUrl": null,
      "jsonMode": "json_object",
      "extraHeaders": {},
      "extraBody": {},
      "modelSource": "models-endpoint",
      "prefer": [],
      "free": false,
      "notes": "Any other OpenAI-compatible address."
    }
  ]
}
