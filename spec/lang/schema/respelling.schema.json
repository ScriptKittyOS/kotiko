{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spec/lang/<base>/respelling.json: the pronunciation respelling key",
  "description": "Slice 07 section 7. alphabet is lowercase (accepted in either case); prompt_summary is the key in a form the prompt carries; the docs render sounds and targets in full. Only bases with a reviewed key have this file; there is no _generic fallback.",
  "type": "object",
  "required": [
    "alphabet",
    "sounds",
    "examples",
    "prompt_summary"
  ],
  "properties": {
    "alphabet": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^A-Z\\s]+$"
    },
    "sounds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sound",
          "written",
          "example"
        ],
        "properties": {
          "sound": {
            "type": "string"
          },
          "written": {
            "type": "string"
          },
          "example": {
            "type": "string"
          }
        }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "lang",
          "native",
          "pronunciation"
        ],
        "properties": {
          "lang": {
            "type": "string"
          },
          "native": {
            "type": "string"
          },
          "pronunciation": {
            "type": "string"
          },
          "pronunciation_careful": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "prompt_summary": {
      "type": "string",
      "maxLength": 800
    },
    "ipa": {
      "description": "Slice 49 section 4a: how Wiktionary's IPA is written for a reader of this base. See the _comment in each file.",
      "type": "object",
      "required": [
        "map",
        "palatal",
        "palatal_before",
        "coda_y",
        "long_double",
        "open_syllable"
      ],
      "properties": {
        "_comment": {
          "type": "string"
        },
        "map": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "targets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "open_syllable": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "palatal": {
          "type": "string"
        },
        "palatal_before": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "long_double": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "coda_y": {
          "type": "string"
        },
        "front_g": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
