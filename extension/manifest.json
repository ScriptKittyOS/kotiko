{
  "manifest_version": 3,
  "name": "Kotiko",
  "short_name": "Kotiko",
  "version": "0.2.0",
  "description": "Learn words as you browse: swaps words on web pages for the ones you're learning, in any language.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["lib/url.js", "lib/validate-words.js", "lib/sync-controller.js", "lib/messages.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/matcher.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kotiko",
    "default_icon": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png" }
  },
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" },
  "browser_specific_settings": { "gecko": { "id": "kotiko@scriptkittyos.com" } }
}
