# ── Required ───────────────────────────────────────────────

# Shared secret the browser extension uses. Make one with:  openssl rand -hex 24
API_TOKEN=

# The model that works out which word you mean. Free key: https://openrouter.ai/keys
LLM_API_KEY=

# ── Telegram bot (optional; you can add words from the extension popup) ──

# From @BotFather in Telegram
TELEGRAM_BOT_TOKEN=

# Leave blank at first. Message your bot once; it replies with your ID to paste here.
# Comma-separate several IDs if other people should be able to add words.
ALLOWED_TELEGRAM_IDS=

# ── Optional ───────────────────────────────────────────────

# Any OpenAI-compatible API. Defaults to OpenRouter's free models, falling back in order.
# Local Ollama instead:  LLM_URL=http://localhost:11434/v1  LLM_MODEL=<from ollama list>
LLM_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free

PORT=4747

# 127.0.0.1 = only this machine. Use your Tailscale IP (or 0.0.0.0) to reach it
# from a laptop's browser too.
BIND=127.0.0.1

# Where the SQLite file lives (default ~/.local/share/slovo)
SLOVO_DATA_DIR=

# ── Voice notes (optional) ─────────────────────────────────
# Local whisper.cpp server:   http://localhost:8178/inference
# Or any OpenAI-compatible:   https://api.openai.com/v1/audio/transcriptions
TRANSCRIBE_URL=
TRANSCRIBE_MODEL=whisper-1
TRANSCRIBE_API_KEY=
