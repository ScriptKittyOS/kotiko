# Copy to .env and keep it private:  cp .env.example .env && chmod 600 .env
# run.sh reads this file with the shell, so single-quote a value that contains $, spaces
# or #, e.g.  LLM_API_KEY='abc$def'. A mistake here stops the server with a message that
# names the setting and how to fix it.

# ── Required ───────────────────────────────────────────────

# The model that works out which word you mean. Free key: https://openrouter.ai/keys
LLM_API_KEY=

# ── API token ──────────────────────────────────────────────

# Optional. Leave empty and Slovo creates a strong token in the data folder; see it
# (and a pairing string for the extension) with:  mix slovo.token
# If you set your own, use at least 24 characters, e.g. from:  openssl rand -hex 24
# API_TOKEN=

# ── Telegram bot (optional; you can add words from the extension popup) ──

# From @BotFather in Telegram
TELEGRAM_BOT_TOKEN=

# Leave blank at first. Message your bot once; it replies with your ID to paste here.
# Comma-separate several IDs if other people should be able to add words.
ALLOWED_TELEGRAM_IDS=

# ── Optional ───────────────────────────────────────────────

# Any OpenAI-compatible API. Defaults to OpenRouter and a list of its free models, tried
# in order (they're often busy). Leave LLM_MODEL commented to get updates to that list.
# Local Ollama instead:  LLM_URL=http://localhost:11434/v1  LLM_MODEL=<from ollama list>
LLM_URL=https://openrouter.ai/api/v1
# LLM_MODEL=qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free

PORT=4747

# 127.0.0.1 = only this machine. Use your Tailscale IP (or 0.0.0.0) to reach it
# from a laptop's browser too. Startup logs say who can reach it.
BIND=127.0.0.1

# Host names you reach the server by, comma-separated, if not localhost, an IP address
# or this machine's own name (e.g. a Tailscale MagicDNS name). Other names get
# "421 Misdirected Request", which stops websites reaching it through DNS rebinding.
ALLOWED_HOSTS=

# The address the extension should use, if not http://<BIND>:<PORT> (e.g. behind a
# reverse proxy). Only used for the pairing string from mix slovo.token.
PUBLIC_URL=

# Where the SQLite file lives (default ~/.local/share/slovo)
SLOVO_DATA_DIR=

# debug, info (default), warning or error. Keys and tokens are kept out of the logs at
# every level.
LOG_LEVEL=

# true logs what you look up (your words) at info level; otherwise only at debug.
LOG_LOOKUPS=

# ── Voice notes (optional) ─────────────────────────────────
# Local whisper.cpp server:   http://localhost:8178/inference
# Or any OpenAI-compatible:   https://api.openai.com/v1/audio/transcriptions
TRANSCRIBE_URL=
TRANSCRIBE_MODEL=whisper-1
TRANSCRIBE_API_KEY=
