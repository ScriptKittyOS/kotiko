# ── Required ───────────────────────────────────────────────

# From @BotFather in Telegram
TELEGRAM_BOT_TOKEN=

# Shared secret the browser extension uses. Make one with:  openssl rand -hex 24
API_TOKEN=

# Any model you already have pulled in Ollama (see: ollama list)
OLLAMA_MODEL=

# Leave blank at first. Message your bot once; it replies with your ID to paste here.
# Comma-separate several IDs if other people should be able to add words.
ALLOWED_TELEGRAM_IDS=

# ── Optional ───────────────────────────────────────────────

OLLAMA_URL=http://localhost:11434
PORT=4747

# 127.0.0.1 = only this machine. Use your Tailscale IP (or 0.0.0.0) to reach it
# from a laptop's browser too.
BIND=127.0.0.1

# Where the SQLite file lives (default ~/.local/share/slovo)
SLOVO_DATA_DIR=

# ── Voice notes (optional) ─────────────────────────────────
# Local whisper.cpp server:   http://localhost:8178/inference
# Or any OpenAI-compatible:   https://api.openai.com/v1/audio/transcriptions
TRANSCRIBE_URL=
TRANSCRIBE_MODEL=whisper-1
TRANSCRIBE_API_KEY=
